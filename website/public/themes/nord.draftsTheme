{"name":"Nord","author":"Draftly, based on Nord","description":"A Draftly adaptation of the Nord palette.","isDark":true,"colors":{"editor":{"foreground":"#d8dee9","muted":"#4c566a","blue":"#81a1c1","frost":"#88c0d0","green":"#a3be8c","yellow":"#ebcb8b","red":"#bf616a","purple":"#b48ead","background":"#2e3440","overlay":"#3b4252"},"interface":{"textForeground":"#d8dee9","textBackground":"#2e3440","textCaret":"#ebcb8b","textSelection":"#4c566a","tint":"#88c0d0"}},"scopes":{"text.normal":{"settings":{"foreground":"foreground"}},"text.heading":{"settings":{"foreground":"frost","fontWeight":"bold"}},"text.bold":{"settings":{"foreground":"blue","fontWeight":"bold"}},"text.italic":{"settings":{"foreground":"green","fontStyle":"italic"}},"text.link":{"settings":{"foreground":"frost"}},"text.quotation":{"settings":{"foreground":"blue"}},"code.inline":{"settings":{"foreground":"yellow","background":"overlay","fontStyle":"monospace"}},"code.block":{"settings":{"foreground":"green","fontStyle":"monospace"}},"code.comment":{"settings":{"foreground":"muted","fontStyle":"italic"}}}}
