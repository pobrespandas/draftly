{"name":"Flexoki Light","author":"Draftly, based on Flexoki","description":"A Draftly adaptation of the Flexoki Light palette.","isDark":false,"colors":{"editor":{"foreground":"#100f0f","muted":"#6f6e69","blue":"#205ea6","cyan":"#24837b","green":"#66800b","yellow":"#ad8301","orange":"#bc5215","red":"#af3029","purple":"#5e409d","background":"#fffcf0","overlay":"#f2f0e5"},"interface":{"textForeground":"#100f0f","textBackground":"#fffcf0","textCaret":"#ad8301","textSelection":"#e6e4d9","tint":"#205ea6"}},"scopes":{"text.normal":{"settings":{"foreground":"foreground"}},"text.heading":{"settings":{"foreground":"blue","fontWeight":"bold"}},"text.bold":{"settings":{"foreground":"orange","fontWeight":"bold"}},"text.italic":{"settings":{"foreground":"cyan","fontStyle":"italic"}},"text.link":{"settings":{"foreground":"blue"}},"text.quotation":{"settings":{"foreground":"green"}},"code.inline":{"settings":{"foreground":"yellow","background":"overlay","fontStyle":"monospace"}},"code.block":{"settings":{"foreground":"cyan","fontStyle":"monospace"}},"code.comment":{"settings":{"foreground":"muted","fontStyle":"italic"}}}}
