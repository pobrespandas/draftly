{"name":"Flexoki Dark","author":"Draftly, based on Flexoki","description":"A Draftly adaptation of the Flexoki Dark palette.","isDark":true,"colors":{"editor":{"foreground":"#cecdc3","muted":"#878580","blue":"#4385be","cyan":"#3aa99f","green":"#879a39","yellow":"#d0a215","orange":"#da702c","red":"#d14d41","purple":"#8b7ec8","background":"#1c1b1a","overlay":"#282726"},"interface":{"textForeground":"#cecdc3","textBackground":"#1c1b1a","textCaret":"#d0a215","textSelection":"#403e3c","tint":"#4385be"}},"scopes":{"text.normal":{"settings":{"foreground":"foreground"}},"text.heading":{"settings":{"foreground":"blue","fontWeight":"bold"}},"text.bold":{"settings":{"foreground":"orange","fontWeight":"bold"}},"text.italic":{"settings":{"foreground":"cyan","fontStyle":"italic"}},"text.link":{"settings":{"foreground":"blue"}},"text.quotation":{"settings":{"foreground":"green"}},"code.inline":{"settings":{"foreground":"yellow","background":"overlay","fontStyle":"monospace"}},"code.block":{"settings":{"foreground":"cyan","fontStyle":"monospace"}},"code.comment":{"settings":{"foreground":"muted","fontStyle":"italic"}}}}
