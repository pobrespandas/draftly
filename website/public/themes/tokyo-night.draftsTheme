{"name":"Tokyo Night","author":"Draftly, based on Tokyo Night","description":"A Draftly adaptation of the Tokyo Night palette.","isDark":true,"colors":{"editor":{"foreground":"#c0caf5","muted":"#565f89","blue":"#7aa2f7","cyan":"#7dcfff","green":"#9ece6a","yellow":"#e0af68","red":"#f7768e","purple":"#bb9af7","background":"#1a1b26","overlay":"#292e42"},"interface":{"textForeground":"#c0caf5","textBackground":"#1a1b26","textCaret":"#c0caf5","textSelection":"#33467c","tint":"#7aa2f7"}},"scopes":{"text.normal":{"settings":{"foreground":"foreground"}},"text.heading":{"settings":{"foreground":"purple","fontWeight":"bold"}},"text.bold":{"settings":{"foreground":"yellow","fontWeight":"bold"}},"text.italic":{"settings":{"foreground":"green","fontStyle":"italic"}},"text.link":{"settings":{"foreground":"blue"}},"text.quotation":{"settings":{"foreground":"cyan"}},"code.inline":{"settings":{"foreground":"yellow","background":"overlay","fontStyle":"monospace"}},"code.block":{"settings":{"foreground":"green","fontStyle":"monospace"}},"code.comment":{"settings":{"foreground":"muted","fontStyle":"italic"}}}}
