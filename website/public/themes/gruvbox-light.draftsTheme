{"name":"Gruvbox Light","author":"Draftly, based on Gruvbox","description":"A Draftly adaptation of the Gruvbox Light palette.","isDark":false,"colors":{"editor":{"foreground":"#3c3836","muted":"#7c6f64","red":"#9d0006","green":"#79740e","yellow":"#b57614","blue":"#076678","purple":"#8f3f71","aqua":"#427b58","orange":"#af3a03","background":"#fbf1c7","overlay":"#ebdbb2"},"interface":{"textForeground":"#3c3836","textBackground":"#fbf1c7","textCaret":"#282828","textSelection":"#d5c4a1","tint":"#076678"}},"scopes":{"text.normal":{"settings":{"foreground":"foreground"}},"text.heading":{"settings":{"foreground":"yellow","fontWeight":"bold"}},"text.bold":{"settings":{"foreground":"orange","fontWeight":"bold"}},"text.italic":{"settings":{"foreground":"purple","fontStyle":"italic"}},"text.link":{"settings":{"foreground":"blue"}},"text.quotation":{"settings":{"foreground":"aqua"}},"code.inline":{"settings":{"foreground":"orange","background":"overlay","fontStyle":"monospace"}},"code.block":{"settings":{"foreground":"green","fontStyle":"monospace"}},"code.comment":{"settings":{"foreground":"muted","fontStyle":"italic"}}}}
