<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleDisplayName</key><string>Draftly</string>
    <key>CFBundleIconFile</key><string>Draftly</string>
    <key>CFBundleName</key><string>Draftly</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.4</string>
    <key>CFBundleVersion</key><string>5</string>
    <key>LSMinimumSystemVersion</key><string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>DraftlyCloudKitContainer</key><string>$(DRAFTLY_CLOUDKIT_CONTAINER)</string>
    <key>SUFeedURL</key><string>https://draftly.pobrespandas.com/appcast.xml</string>
    <key>SUPublicEDKey</key><string>$(DRAFTLY_SPARKLE_PUBLIC_KEY)</string>
    <key>DraftlyUpdatesEnabled</key><string>$(DRAFTLY_UPDATES_ENABLED)</string>
    <key>SUEnableAutomaticChecks</key><true/>
    <key>SUAutomaticallyUpdate</key><false/>
    <key>SUAllowsAutomaticUpdates</key><false/>
    <key>SURequireSignedFeed</key><true/>
    <key>SUVerifyUpdateBeforeExtraction</key><true/>
    <key>NSAppleEventsUsageDescription</key><string>Run AppleScript actions that you choose.</string>
    <key>NSCalendarsFullAccessUsageDescription</key><string>Create calendar events from your drafts.</string>
    <key>NSRemindersFullAccessUsageDescription</key><string>Create reminders from your drafts.</string>
    <key>NSMicrophoneUsageDescription</key><string>Record speech for dictation actions that you run.</string>
    <key>NSSpeechRecognitionUsageDescription</key><string>Transcribe audio in actions that you run.</string>
    <key>NSLocationUsageDescription</key><string>Use location in actions that you run.</string>
    <key>NSLocationWhenInUseUsageDescription</key><string>Use location in actions that you run.</string>
    <key>NSServices</key><array>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Capture to Draftly</string></dict>
            <key>NSMessage</key><string>captureSelectionDirectly</string>
            <key>NSPortName</key><string>Draftly</string>
            <key>NSTimeout</key><string>120000</string>
            <key>NSRequiredContext</key><dict/>
            <key>NSSendTypes</key><array>
                <string>public.utf8-plain-text</string><string>NSStringPboardType</string>
                <string>public.rtf</string><string>NSRTFPboardType</string>
                <string>com.apple.flat-rtfd</string><string>NSRTFDPboardType</string>
                <string>public.url</string><string>NSURLPboardType</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Capture to Draftly with Options</string></dict>
            <key>NSMessage</key><string>captureSelectionWithOptions</string>
            <key>NSPortName</key><string>Draftly</string>
            <key>NSTimeout</key><string>120000</string>
            <key>NSRequiredContext</key><dict/>
            <key>NSSendTypes</key><array>
                <string>public.utf8-plain-text</string><string>NSStringPboardType</string>
                <string>public.rtf</string><string>NSRTFPboardType</string>
                <string>com.apple.flat-rtfd</string><string>NSRTFDPboardType</string>
                <string>public.url</string><string>NSURLPboardType</string>
            </array>
        </dict>
    </array>
    <key>CFBundleURLTypes</key><array><dict><key>CFBundleURLName</key><string>Draftly Links</string><key>CFBundleURLSchemes</key><array><string>draftly</string></array></dict></array>
</dict></plist>
